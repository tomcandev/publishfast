# Copy to .env and fill in. Never commit the real .env.

# Secret used to sign session tokens. Generate: openssl rand -hex 32
AUTH_SECRET=

# HTTP port the server listens on (bound to 127.0.0.1)
PORT=8055
HOST=127.0.0.1

# Where the SQLite file and uploaded media live.
# Relative paths resolve from the repo root.
DATA_DIR=./data

# Public origin, used for absolute links. No trailing slash.
PUBLIC_URL=http://localhost:8055

# Max upload size in bytes (default 512MB)
MAX_UPLOAD_BYTES=536870912

# Max size of one drop-box file (PUT /api/files/<key>), default 90MB (under Cloudflare's 100MB body limit)
MAX_FILE_BYTES=94371840

# Part size for uploads in parts (large videos through the tunnel), default 32MB
UPLOAD_PART_BYTES=33554432

# Drop box total per token prefix, ingest-token total of draft+ready media, free-disk floor
MAX_FILES_PREFIX_BYTES=2147483648
MAX_INGEST_BYTES=5368709120
MIN_FREE_BYTES=2147483648

# Longest one request may take, body included (default 30 minutes)
REQUEST_TIMEOUT_MS=1800000

# Off by default. 1/true: the scheduler deletes files in data/uploads that no asset
# row names and that are older than one hour (see docs/deployment.md before turning it on).
SWEEP_ORPHAN_UPLOADS=0
